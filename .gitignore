# =============================================================================
# SECRETOS Y CREDENCIALES — nunca se versionan
# =============================================================================
# Variables de entorno (solo se versionan las plantillas)
.env
.env.*
*.env
!.env.example
!**/.env.example
!env.template

# Credenciales generadas por deploy.sh
credentials.txt
**/credentials*.txt
*.credentials

# Certificados y claves privadas (autofirmados o Let's Encrypt)
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore
docker/nginx/ssl/*
!docker/nginx/ssl/.gitignore
!docker/nginx/ssl/README.md
docker/nginx/acme/
letsencrypt/

# Claves SSH y tokens
id_rsa*
id_ed25519*
*.ppk
.ssh/
*secret*.json
*token*.json
service-account*.json
.npmrc.local

# Volcados de base de datos y respaldos (contienen datos reales)
*.sql
*.sql.gz
*.dump
*.bak
*.backup
backups/
.env.backup_*

# Datos de llamadas: grabaciones y capturas SIP/RTP (números y audio reales)
/recordings/
*.wav
*.gsm
*.pcap
*.pcapng
/docs/traza/

# =============================================================================
# Python / Django
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
local_settings.py
db.sqlite3
db.sqlite3-journal
/static/
/media/
.pytest_cache/
.coverage
htmlcov/
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# =============================================================================
# Node / Nuxt
# =============================================================================
node_modules/
.nuxt/
.output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Docker
# =============================================================================
docker-compose.override.yml

# =============================================================================
# Logs
# =============================================================================
logs/
*.log

# =============================================================================
# IDEs / SO / herramientas
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.kiro/
kiro/
.agents/

# =============================================================================
# Documentación: solo Markdown del README y de docs/
# =============================================================================
*.docx
*.pdf
*.md
!README.md
!/docs/**/*.md
!docker/nginx/ssl/README.md

# =============================================================================
# Scripts raíz: solo se versionan los necesarios
# =============================================================================
/*.sh
!deploy.sh
!fix-db-password.sh
!backup-production.sh
!voip-debug.sh
!generate-dev-ssl.sh
*.ps1

# Scripts Docker - NUNCA ignorar (necesarios para build)
!docker/**/*.sh
