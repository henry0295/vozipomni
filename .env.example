# VoziPOmni Environment Variables - PRODUCTION

# Django
DEBUG=False
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
FIELD_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION

# Database
DB_NAME=vozipomni_db
DB_USER=vozipomni_user
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379/0

# Asterisk
ASTERISK_HOST=asterisk
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=admin
ASTERISK_AMI_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Security (IMPORTANTE: Cambiar para producción)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,yourdomain.com

# CORS (IMPORTANTE: Configurar dominios permitidos)
# Separar múltiples orígenes con comas
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ALL=False

# API - No usado en producción, solo para desarrollo local
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
VITE_ASTERISK_WS=wss://localhost:8089/ws

# Docker Compose Production
POSTGRES_DB=vozipomni
POSTGRES_USER=vozipomni_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
GRAFANA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Frontend (Nuxt) - Production
# En producción estas variables se configuran en docker-compose.prod.yml
# y usan rutas relativas porque están detrás del mismo nginx
NUXT_PUBLIC_API_BASE=/api
NUXT_PUBLIC_WS_BASE=/ws

# ==========================================
# Correo (recuperación de contraseña y reportes programados)
# Si EMAIL_HOST está vacío los correos solo se escriben en el log.
# ==========================================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VozipOmni <no-reply@tu-dominio.com>

# URL pública del frontend (enlaces de "recuperar contraseña")
FRONTEND_URL=https://tu-dominio.com

# ==========================================
# WhatsApp Business (Meta Cloud API)
# Meta exige HTTPS con certificado válido en un dominio público para el webhook.
# ==========================================
PUBLIC_BASE_URL=https://tu-dominio.com
WHATSAPP_GRAPH_API_VERSION=v21.0
